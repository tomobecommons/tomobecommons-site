<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or org.name }}</title>
<meta name="description" content="{{ description or '特定非営利活動法人友部コモンズは、茨城県笠間市を拠点に、森林再生・有機農業・共助コミュニティ・子どもの学びに取り組むNPO法人です。' }}">
<style>
  :root{
    --ink:#23302a;
    --ink-soft:#4a5a52;
    --line:#dfe5e0;
    --bg:#fbfaf7;
    --accent:#3d6b4f;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,sans-serif;
    color:var(--ink);
    background:var(--bg);
    line-height:1.9;
    font-size:16px;
  }
  .wrap{max-width:760px;margin:0 auto;padding:0 24px;}
  header{
    background:var(--accent);
    color:#fff;
    padding:56px 0 48px;
  }
  header .lead{
    font-size:14px;
    letter-spacing:.14em;
    opacity:.85;
    margin:0 0 10px;
  }
  header h1{
    font-size:28px;
    margin:0 0 20px;
    line-height:1.5;
    font-weight:700;
  }
  header p.mission{
    margin:0;
    font-size:17px;
    line-height:1.9;
  }
  main{padding:48px 0 8px;}
  section{margin:0 0 44px;}
  h2{
    font-size:19px;
    margin:0 0 16px;
    padding:0 0 10px;
    border-bottom:2px solid var(--accent);
    display:inline-block;
  }
  p{margin:0 0 16px;}
  ul{margin:0 0 16px;padding-left:1.3em;}
  li{margin-bottom:8px;}
  table{
    width:100%;
    border-collapse:collapse;
    font-size:15px;
  }
  th,td{
    text-align:left;
    vertical-align:top;
    padding:12px 8px;
    border-bottom:1px solid var(--line);
  }
  th{
    width:32%;
    font-weight:600;
    color:var(--ink-soft);
    white-space:nowrap;
  }
  .activity{
    border:1px solid var(--line);
    background:#fff;
    border-radius:6px;
    padding:20px 22px;
    margin-bottom:14px;
  }
  .activity h3{
    margin:0 0 8px;
    font-size:16px;
    color:var(--accent);
  }
  .activity p{margin:0;font-size:15px;}
  .news-item{
    border-bottom:1px solid var(--line);
    padding:16px 0;
  }
  .news-item:first-of-type{border-top:1px solid var(--line);}
  .news-item time{
    display:block;
    font-size:13px;
    color:var(--ink-soft);
    margin-bottom:4px;
  }
  .news-item h3{
    margin:0 0 8px;
    font-size:16px;
  }
  .news-item .body{font-size:15px;}
  .news-item .body p:last-child{margin-bottom:0;}
  .news-item img{max-width:100%;height:auto;border-radius:4px;}
  a{color:var(--accent);}
  footer{
    border-top:1px solid var(--line);
    margin-top:24px;
    padding:28px 0 48px;
    font-size:14px;
    color:var(--ink-soft);
  }
  @media(max-width:600px){
    header{padding:40px 0 36px;}
    header h1{font-size:23px;}
    th,td{display:block;width:100%;border-bottom:none;padding:4px 0;}
    td{padding-bottom:14px;border-bottom:1px solid var(--line);}
  }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <p class="lead">{{ org.nameEn }}</p>
    <h1>{{ org.name }}</h1>
    <p class="mission">{{ org.mission | br | safe }}</p>
  </div>
</header>

<main class="wrap">
{{ content | safe }}
</main>

<footer class="wrap">
  <p>{{ org.name }}<br>
  {{ org.postalCode }}　{{ org.address }}<br>
  {{ org.email }}</p>
  <p>&copy; Tomobe Commons</p>
</footer>

</body>
</html>
